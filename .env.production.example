# Copy this file to .env.production and fill values
DOMAIN=chat.yourdomain.com

# Set a long random value (minimum 32 chars)
SECRET_KEY=replace_with_a_long_random_secret_key

# Change default credentials before production
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_strong_password

# Optional toggles
LLM_ENABLED=true
CORS_ORIGINS=*
